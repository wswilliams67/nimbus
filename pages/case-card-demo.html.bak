              <a class="alert-popover-item-action">FIX</a>
            </div>
          </div>
        </div>
      </div>
      <!-- Card 19 -->
      <div
        class="case-card"
        data-tooltip="Urban Development LLC V. City Council"
      >
        <div class="card-body">
          <div class="card-top">
            <div class="card-titles">
              <div class="card-title">
                Urban Development LLC V. City Council
              </div>
            </div>
          </div>
          <div class="card-ref-line">
            <span class="ref-label">Reference ID:</span>
            <span class="ref-value">5678-0012-34567-890123-GHI-4321</span>
          </div>
          <div class="card-created">
            Created by: Bran Stark on Sun Jun 07, 2019
          </div>
          <div class="card-chevron">
            <span class="mdi mdi-chevron-down"></span
            ><span class="mdi mdi-chevron-up"></span>
          </div>
        </div>
        <div class="card-expanded-wrapper">
          <div class="card-expanded-content">
            <p class="card-description">
              Eminent domain challenge where Urban Development LLC contests the
              City Council's condemnation of commercial properties for a public
              transit expansion project. The dispute centers on fair market
              valuation and whether the taking serves a legitimate public
              purpose. Independent appraisals have been commissioned by both
              parties.
            </p>
            <div class="card-metadata">
              <div class="card-metadata-row">
                <span class="metadata-label">Primary Counsel</span>
                <span class="metadata-value">David Jones</span>
              </div>
              <div class="card-metadata-row">
                <span class="metadata-label">Outside Counsel</span>
                <span class="metadata-value">Amanda Moore</span>
              </div>
              <div class="card-metadata-row">
                <span class="metadata-label">Natural Persons</span>
                <span class="metadata-value">4</span>
              </div>
              <div class="card-metadata-row">
                <span class="metadata-label">Identities</span>
                <span class="metadata-value">5</span>
              </div>
              <div class="card-metadata-row">
                <span class="metadata-label">Interviews</span>
                <span class="metadata-value">12</span>
              </div>
            </div>
          </div>
        </div>
        <div class="card-footer">
          <div class="card-footer-status">
            <span class="status-dot status-dot-active"></span>
            <span class="status-label">Active</span>
          </div>

          <span class="card-footer-spacer"></span>
          <button class="btn-view">View</button>
        </div>
      </div>
    </div>
    <!-- /card-grid -->

    <!-- ===== PAGINATION BAR ===== -->
    <div class="pagination-bar">
      <label
        >Rows per page:
        <select id="rowsPerPage">
          <option>10</option>
          <option selected>20</option>
          <option>50</option>
        </select>
      </label>
      <span id="paginationInfo" class="pagination-info">1–19 of 19</span>
      <div class="pagination-controls">
        <button id="pageFirst"><span class="mdi mdi-page-first"></span></button>
        <button id="pagePrev">
          <span class="mdi mdi-chevron-left"></span>
        </button>
        <button id="pageNext">
          <span class="mdi mdi-chevron-right"></span>
        </button>
        <button id="pageLast"><span class="mdi mdi-page-last"></span></button>
      </div>
    </div>

    <!-- ===== TOOLTIP ===== -->
    <div class="case-tooltip" id="caseTooltip"></div>

    <!-- ===== JAVASCRIPT ===== -->
    <script>
      (function () {
        /* ========== REFS ========== */
        var grid = document.querySelector(".card-grid");
        var allCards = Array.prototype.slice.call(
          grid.querySelectorAll(".case-card")
        );
        var searchInput = document.querySelector(".toolbar-search");
        var searchBtn = document.querySelector(".btn-search");
        var statusFilter = document.getElementById("statusFilter");
        var sortBy = document.getElementById("sortBy");
        var ascBtn = document.querySelector(".btn-asc-desc");
        var totalLabel = document.querySelector(".toolbar-total");
        var rowsPerPage = document.getElementById("rowsPerPage");
        var paginationInfo = document.getElementById("paginationInfo");
        var pageFirst = document.getElementById("pageFirst");
        var pagePrev = document.getElementById("pagePrev");
        var pageNext = document.getElementById("pageNext");
        var pageLast = document.getElementById("pageLast");

        /* ========== STATE ========== */
        var sortAsc = true;
        var currentPage = 1;
        var filtered = allCards.slice();

        /* ========== HELPERS ========== */
        function getCardName(card) {
          var el = card.querySelector(".card-title");
          return el ? el.textContent.trim().toLowerCase() : "";
        }
        function getCardRefId(card) {
          var el = card.querySelector(".ref-value");
          return el ? el.textContent.trim().toLowerCase() : "";
        }
        function getCardDate(card) {
          var el = card.querySelector(".card-created");
          if (!el) return new Date(0);
          var txt = el.textContent.trim();
          var m = txt.match(/on\s+(.+)$/);
          return m ? new Date(m[1]) : new Date(0);
        }
        function getCardStatus(card) {
          var el = card.querySelector(".status-label");
          return el ? el.textContent.trim() : "";
        }

        /* ========== FILTER + SORT ========== */
        function applyFilterAndSort() {
          var query = searchInput.value.trim().toLowerCase();
          var status = statusFilter.value;
          var field = sortBy.value;

          filtered = allCards.filter(function (card) {
            var matchSearch =
              !query ||
              getCardName(card).indexOf(query) !== -1 ||
              getCardRefId(card).indexOf(query) !== -1;
            var matchStatus =
              status === "All" || getCardStatus(card) === status;
            return matchSearch && matchStatus;
          });

          filtered.sort(function (a, b) {
            var va, vb;
            if (field === "date") {
              va = getCardDate(a).getTime();
              vb = getCardDate(b).getTime();
              return sortAsc ? va - vb : vb - va;
            } else if (field === "refid") {
              va = getCardRefId(a);
              vb = getCardRefId(b);
            } else {
              va = getCardName(a);
              vb = getCardName(b);
            }
            var cmp = va < vb ? -1 : va > vb ? 1 : 0;
            return sortAsc ? cmp : -cmp;
          });

          currentPage = 1;
          render();
        }

        /* ========== RENDER ========== */
        function render() {
          /* Close any open card-level popovers — grid layout is changing,
             so positions would be stale. They'll reposition correctly
             (including top-row offset) when reopened. */
          document
            .querySelectorAll(".case-card .alert-popover.open")
            .forEach(function (p) {
              p.classList.remove("open");
            });

          var perPage = parseInt(rowsPerPage.value, 10) || 20;
          var totalItems = filtered.length;
          var totalPages = Math.max(1, Math.ceil(totalItems / perPage));
          if (currentPage > totalPages) currentPage = totalPages;
          var start = (currentPage - 1) * perPage;
          var end = Math.min(start + perPage, totalItems);
          var visible = filtered.slice(start, end);

          /* hide all, show visible page */
          allCards.forEach(function (c) {
            c.style.display = "none";
          });
          visible.forEach(function (c) {
            c.style.display = "";
          });

          /* reorder DOM to match sort */
          filtered.forEach(function (c) {
            grid.appendChild(c);
          });

          /* update total */
          totalLabel.textContent = "Total Cases: " + totalItems;

          /* update pagination info */
          if (totalItems === 0) {
            paginationInfo.textContent = "0 of 0";
          } else {
            paginationInfo.textContent =
              start + 1 + "\u2013" + end + " of " + totalItems;
          }

          /* update pagination buttons */
          pageFirst.disabled = currentPage <= 1;
          pagePrev.disabled = currentPage <= 1;
          pageNext.disabled = currentPage >= totalPages;
          pageLast.disabled = currentPage >= totalPages;

          /* re-equalize expanded row heights after render */
          setTimeout(equalizeExpandedRow, 10);
        }

        /* ========== EVENT LISTENERS ========== */

        /* Search */
        searchBtn.addEventListener("click", function () {
          applyFilterAndSort();
        });
        searchInput.addEventListener("keydown", function (e) {
          if (e.key === "Enter") applyFilterAndSort();
        });
        searchInput.addEventListener("input", function () {
          var wrapper = this.closest(".search-input-wrapper");
          if (wrapper)
            wrapper.classList.toggle("has-value", this.value.length > 0);
          applyFilterAndSort();
        });
        /* Catch browser autocomplete which may not fire 'input' */
        searchInput.addEventListener("change", function () {
          var wrapper = this.closest(".search-input-wrapper");
          if (wrapper)
            wrapper.classList.toggle("has-value", this.value.length > 0);
          applyFilterAndSort();
        });
        /* Poll for autocomplete value changes while input is focused */
        (function () {
          var lastVal = searchInput.value;
          var pollId = null;
          searchInput.addEventListener("focus", function () {
            lastVal = searchInput.value;
            pollId = setInterval(function () {
              if (searchInput.value !== lastVal) {
                lastVal = searchInput.value;
                var wrapper = searchInput.closest(".search-input-wrapper");
                if (wrapper)
                  wrapper.classList.toggle(
                    "has-value",
                    searchInput.value.length > 0
                  );
                applyFilterAndSort();
              }
            }, 100);
          });
          searchInput.addEventListener("blur", function () {
            if (pollId) {
              clearInterval(pollId);
              pollId = null;
            }
          });
        })();

        /* Search clear icon */
        var searchClear = document.querySelector(".search-clear");
        if (searchClear) {
          searchClear.addEventListener("click", function () {
            searchInput.value = "";
            var wrapper = searchInput.closest(".search-input-wrapper");
            if (wrapper) wrapper.classList.remove("has-value");
            applyFilterAndSort();
            searchInput.focus();
          });
        }

        /* Status filter */
        statusFilter.addEventListener("change", function () {
          applyFilterAndSort();
        });

        /* Sort by */
        sortBy.addEventListener("change", function () {
          applyFilterAndSort();
        });

        /* Asc / Dsc toggle */
        ascBtn.addEventListener("click", function () {
          sortAsc = !sortAsc;
          var icon = this.querySelector(".mdi");
          var label = this.querySelector(".btn-asc-desc-label");
          if (sortAsc) {
            icon.classList.remove("mdi-arrow-down-circle-outline");
            icon.classList.add("mdi-arrow-up-circle-outline");
            label.textContent = "ASC";
          } else {
            icon.classList.remove("mdi-arrow-up-circle-outline");
            icon.classList.add("mdi-arrow-down-circle-outline");
            label.textContent = "DSC";
          }
          applyFilterAndSort();
        });

        /* Rows per page */
        rowsPerPage.addEventListener("change", function () {
          currentPage = 1;
          render();
        });

        /* Pagination buttons */
        pageFirst.addEventListener("click", function () {
          currentPage = 1;
          render();
        });
        pagePrev.addEventListener("click", function () {
          if (currentPage > 1) {
            currentPage--;
            render();
          }
        });
        pageNext.addEventListener("click", function () {
          var perPage = parseInt(rowsPerPage.value, 10) || 20;
          var totalPages = Math.max(1, Math.ceil(filtered.length / perPage));
          if (currentPage < totalPages) {
            currentPage++;
            render();
          }
        });
        pageLast.addEventListener("click", function () {
          var perPage = parseInt(rowsPerPage.value, 10) || 20;
          currentPage = Math.max(1, Math.ceil(filtered.length / perPage));
          render();
        });

        /* ========== THEME TOGGLE ========== */
        var themeToggle = document.querySelector('[data-cnds-toggle="theme"]');
        if (themeToggle) {
          themeToggle.addEventListener("click", function () {
            var html = document.documentElement;
            var current = html.getAttribute("data-cnds-theme") || "light";
            var next = current === "light" ? "dark" : "light";
            html.setAttribute("data-cnds-theme", next);
            var icon = this.querySelector(".mdi");
            if (icon) {
              icon.classList.toggle("mdi-weather-night");
              icon.classList.toggle("mdi-weather-sunny");
            }
            var newTip =
              next === "dark"
                ? "Switch to light theme"
                : "Switch to dark theme";
            this.setAttribute("data-tooltip", newTip);
            /* Update visible tooltip text immediately if tooltip is showing */
            var visibleTip = document.getElementById("caseTooltip");
            if (visibleTip && visibleTip.style.display === "block") {
              visibleTip.textContent = newTip;
            }
            try {
              localStorage.setItem("cnds-theme", next);
            } catch (e) {}
          });
        }
        try {
          var saved = localStorage.getItem("cnds-theme");
          if (saved) {
            document.documentElement.setAttribute("data-cnds-theme", saved);
            if (saved === "dark" && themeToggle) {
              var icon = themeToggle.querySelector(".mdi");
              if (icon) {
                icon.classList.remove("mdi-weather-night");
                icon.classList.add("mdi-weather-sunny");
              }
              themeToggle.setAttribute("data-tooltip", "Switch to light theme");
            }
          }
        } catch (e) {}

        /* ========== THEME TOGGLE TOOLTIP ========== */
        if (themeToggle) {
          var ttTooltip = document.getElementById("caseTooltip");
          themeToggle.addEventListener("mouseenter", function () {
            var text = this.getAttribute("data-tooltip");
            if (text) {
              ttTooltip.textContent = text;
              ttTooltip.style.display = "block";
              /* Position to the left of the button */
              var rect = this.getBoundingClientRect();
              var tipW = ttTooltip.offsetWidth;
              ttTooltip.style.left = rect.left - tipW - 8 + "px";
              ttTooltip.style.top =
                rect.top + (rect.height - ttTooltip.offsetHeight) / 2 + "px";
            }
          });
          themeToggle.addEventListener("mouseleave", function () {
            ttTooltip.style.display = "none";
          });
        }

        /* ========== ALERT INDICATOR TOOLTIPS ========== */
        (function () {
          var tip = document.getElementById("caseTooltip");
          document
            .querySelectorAll(
              ".alert-indicator-danger[data-tooltip], .alert-indicator-warning[data-tooltip], .alert-indicator-info[data-tooltip]"
            )
            .forEach(function (ind) {
              ind.addEventListener("mouseenter", function () {
                var text = this.getAttribute("data-tooltip");
                if (!text) return;
                tip.textContent = text;
                tip.style.display = "block";
                var rect = this.getBoundingClientRect();
                var tipW = tip.offsetWidth;
                var tipH = tip.offsetHeight;
                tip.style.left = rect.left + rect.width / 2 - tipW / 2 + "px";
                tip.style.top = rect.top - tipH - 6 + "px";
              });
              ind.addEventListener("mouseleave", function () {
                tip.style.display = "none";
              });
            });
        })();

        /* ========== CARD EXPAND / COLLAPSE ========== */
        function equalizeExpandedRow(expandingCard) {
          var grid = document.querySelector(".card-grid");
          if (!grid) return;
          var cards = Array.from(grid.querySelectorAll(".case-card"));

          /* Clear min-height on collapsed cards */
          cards.forEach(function (c) {
            if (!c.classList.contains("expanded")) {
              c.style.minHeight = "";
            }
          });

          /* Group expanded visible cards by visual row */
          var expanded = cards.filter(function (c) {
            return (
              c.classList.contains("expanded") && c.style.display !== "none"
            );
          });
          if (expanded.length === 0) return;

          var rows = {};
          expanded.forEach(function (c) {
            var top = Math.round(c.getBoundingClientRect().top);
            var rowKey = null;
            for (var k in rows) {
              if (Math.abs(parseInt(k) - top) < 5) {
                rowKey = k;
                break;
              }
            }
            if (!rowKey) {
              rowKey = top;
              rows[rowKey] = [];
            }
            rows[rowKey].push(c);
          });

          for (var key in rows) {
            if (rows[key].length < 2) {
              /* Single expanded card in row — if it has a min-height,
                 transition it down to its natural height */
              var solo = rows[key][0];
              if (solo.style.minHeight) {
                /* Measure natural height without min-height constraint */
                var oldMin = solo.style.minHeight;
                solo.style.transition = "none";
                solo.style.minHeight = "";
                void solo.offsetHeight;
                var naturalH = solo.offsetHeight;
                /* Restore old min-height as starting point */
                solo.style.minHeight = oldMin;
                void solo.offsetHeight;
                /* Re-enable transition and set target */
                solo.style.transition = "";
                solo.style.minHeight = naturalH + "px";
                /* After transition completes, clear min-height entirely */
                var clearHandler = function (e) {
                  if (e.propertyName === "min-height") {
                    solo.removeEventListener("transitionend", clearHandler);
                    solo.style.minHeight = "";
                  }
                };
                solo.addEventListener("transitionend", clearHandler);
              }
              continue;
            }

            /* Predict final height for each card */
            var maxH = 0;
            rows[key].forEach(function (c) {
              var h;
              if (c === expandingCard) {
                /* Card is mid-transition: predict final height */
                var content = c.querySelector(".card-expanded-content");
                h = c.offsetHeight + (content ? content.scrollHeight : 0);
              } else {
                /* Already expanded: scrollHeight is accurate */
                h = c.scrollHeight;
              }
              if (h > maxH) maxH = h;
            });

            rows[key].forEach(function (c) {
              var currentH = c.offsetHeight;
              if (currentH < maxH) {
                c.style.minHeight = currentH + "px";
                void c.offsetHeight;
                c.style.minHeight = maxH + "px";
              } else {
                c.style.minHeight = maxH + "px";
              }
            });
          }
        }

        document.querySelectorAll(".card-chevron").forEach(function (chevron) {
          chevron.addEventListener("click", function () {
            var card = this.closest(".case-card");
            var wasExpanded = card.classList.contains("expanded");
            card.classList.toggle("expanded");
            if (wasExpanded) {
              /* Collapsing: keep white-space normal during max-height animation
                 so the title text wraps smoothly back into truncation */
              var titleEl = card.querySelector(".card-title");
              if (titleEl) {
                titleEl.style.whiteSpace = "normal";
                titleEl.style.textOverflow = "unset";
                var onEnd = function (e) {
                  if (e.propertyName === "max-height") {
                    titleEl.style.whiteSpace = "";
                    titleEl.style.textOverflow = "";
                    titleEl.removeEventListener("transitionend", onEnd);
                  }
                };
                titleEl.addEventListener("transitionend", onEnd);
                /* Fallback: clear inline styles after transition duration */
                setTimeout(function () {
                  titleEl.style.whiteSpace = "";
                  titleEl.style.textOverflow = "";
                }, 400);
              }
              card.style.minHeight = "";
              equalizeExpandedRow(null);
            } else {
              /* Double rAF ensures the browser has committed the class change
                 and started the CSS transition before we measure/set min-height */
              requestAnimationFrame(function () {
                requestAnimationFrame(function () {
                  equalizeExpandedRow(card);
                });
              });
              /* Re-equalize after the expand transition completes for accuracy */
              setTimeout(function () {
                equalizeExpandedRow(null);
              }, 380);
            }
          });
        });

        /* Re-equalize on resize */
        var resizeTimer;
        window.addEventListener("resize", function () {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(equalizeExpandedRow, 100);
        });

        /* ========== FIXED HEADER OFFSET, PAGINATION CLEARANCE & SHADOW ========== */
        var header = document.querySelector(".sticky-header");
        var cardGrid = document.querySelector(".card-grid");
        var paginationBar = document.querySelector(".pagination-bar");
        if (header && cardGrid) {
          function updateLayout() {
            cardGrid.style.marginTop = header.offsetHeight + "px";
            /* Only add extra bottom padding if content would scroll behind pagination */
            cardGrid.style.paddingBottom = "16px"; /* reset */
            var docH = document.documentElement.scrollHeight;
            var viewH = window.innerHeight;
            if (paginationBar && docH > viewH) {
              var pagH =
                paginationBar.offsetHeight + 32; /* bar + bottom offset + gap */
              cardGrid.style.paddingBottom = pagH + "px";
            }
          }
          updateLayout();
          window.addEventListener("resize", updateLayout);
          window.addEventListener("scroll", function () {
            header.classList.toggle("scrolled", window.scrollY > 0);
          });
        }

        /* ========== TOOLTIP (only on truncated title hover) ========== */
        var tooltip = document.getElementById("caseTooltip");
        document
          .querySelectorAll(".case-card .card-title")
          .forEach(function (title) {
            title.addEventListener("mouseenter", function () {
              if (this.scrollWidth > this.clientWidth) {
                var card = this.closest("[data-tooltip]");
                if (card) {
                  tooltip.textContent = card.getAttribute("data-tooltip");
                  tooltip.style.display = "block";
                  this.style.cursor = "help";
                }
              }
            });
            title.addEventListener("mousemove", function (e) {
              if (tooltip.style.display === "block") {
                tooltip.style.left = e.clientX + 12 + "px";
                tooltip.style.top = e.clientY + 12 + "px";
              }
            });
            title.addEventListener("mouseleave", function () {
              tooltip.style.display = "none";
              this.style.cursor = "";
            });
          });

        /* ========== DROPDOWN MENU TOGGLES ========== */
        (function () {
          var accountToggle = document.getElementById("userAccountToggle");
          var accountMenu = document.getElementById("accountMenu");
          var accountWrapper = document.getElementById("userAccountWrapper");

          var portalToggle = document.getElementById("portalSwitcherToggle");
          var portalMenu = document.getElementById("portalMenu");
          var portalWrapper = document.getElementById("portalSwitcherWrapper");
          var portalChevron = document.getElementById("portalChevron");

          function updatePortalChevron() {
            if (!portalChevron) return;
            var isOpen = portalMenu && portalMenu.classList.contains("open");
            portalChevron.classList.toggle("mdi-chevron-down", !isOpen);
            portalChevron.classList.toggle("mdi-chevron-up", isOpen);
          }

          /* Account menu toggle */
          if (accountToggle && accountMenu && accountWrapper) {
            accountToggle.addEventListener("click", function (e) {
              e.stopPropagation();
              /* Close portal menu if open */
              if (portalMenu) portalMenu.classList.remove("open");
              updatePortalChevron();
              /* Close bell popover if open */
              var navPop = document.getElementById("navAlertPopover");
              if (navPop) navPop.classList.remove("open");
              accountMenu.classList.toggle("open");
            });
          }

          /* Portal menu toggle */
          if (portalToggle && portalMenu && portalWrapper) {
            portalToggle.addEventListener("click", function (e) {
              e.stopPropagation();
              /* Close account menu if open */
              if (accountMenu) accountMenu.classList.remove("open");
              /* Close bell popover if open */
              var navPop = document.getElementById("navAlertPopover");
              if (navPop) navPop.classList.remove("open");
              portalMenu.classList.toggle("open");
              updatePortalChevron();
            });
          }

          /* Click-away: close any open menu */
          document.addEventListener("click", function (e) {
            if (
              accountMenu &&
              accountWrapper &&
              !accountWrapper.contains(e.target)
            ) {
              accountMenu.classList.remove("open");
            }
            if (
              portalMenu &&
              portalWrapper &&
              !portalWrapper.contains(e.target)
            ) {
              portalMenu.classList.remove("open");
              updatePortalChevron();
            }
          });
        })();

        /* ========== ALERT POPOVER TOGGLE ========== */
        (function () {
          /* Helper: update the total count in a popover header.
             Works for both card-level (.alert-popover) and nav (.notif-popover). */
          function updatePopoverCounts(popover) {
            if (!popover) return;

            /* --- Nav notification popover --- */
            if (popover.classList.contains("notif-popover")) {
              var notifList = popover.querySelector(".notif-list");
              if (!notifList) return;
              var allItems = notifList.querySelectorAll(".notif-item");
              var unreadItems =
                notifList.querySelectorAll(".notif-item.unread");
              var totalEl = popover.querySelector(".notif-count-total");
              var unreadEl = popover.querySelector(".notif-count-unread");
              if (totalEl) totalEl.textContent = allItems.length + " Total";
              if (unreadEl)
                unreadEl.textContent = unreadItems.length + " Unread";
              return;
            }

            /* --- Card-level alert popover (unchanged) --- */
            var list = popover.querySelector(".alert-popover-list");
            if (!list) return;
            var items = list.querySelectorAll(".alert-popover-item");
            var total = items.length;
            var countEl = popover.querySelector(".alert-popover-count");
            if (countEl) {
              countEl.textContent = total + " Total";
            }
            /* Also update the danger count badge on the card footer */
            var card = popover.closest(".case-card");
            if (card) {
              var dangerCount = card.querySelector(
                ".alert-indicator-danger .alert-count.alert-count-danger"
              );
              if (dangerCount) {
                dangerCount.textContent = total;
              }
            }
          }

          /* ===== NAV BELL ICON TOGGLE ===== */
          var navBellBtn = document.getElementById("navBellBtn");
          var navAlertPopover = document.getElementById("navAlertPopover");
          var navAlertWrapper = document.getElementById("navAlertWrapper");

          if (navBellBtn && navAlertPopover) {
            /* Move popover to body so it escapes the sticky-header stacking context */
            document.body.appendChild(navAlertPopover);

            /* Position the nav popover top edge below the bell button */
            function positionNavPopover() {
              var btnRect = navBellBtn.getBoundingClientRect();
              navAlertPopover.style.top = btnRect.bottom + 10 + "px";
              /* Position arrow to point at bell button center */
              var popoverRight = 16; /* matches CSS right: 16px */
              var btnCenterX = btnRect.left + btnRect.width / 2;
              var arrowRight =
                window.innerWidth - popoverRight - btnCenterX - 8;
              navAlertPopover.style.setProperty(
                "--nav-arrow-right",
                Math.max(8, arrowRight) + "px"
              );
            }

            navBellBtn.addEventListener("click", function (e) {
              e.stopPropagation();
              /* Close all card-level popovers first */
              document
                .querySelectorAll(".case-card .alert-popover.open")
                .forEach(function (p) {
                  p.classList.remove("open");
                });
              /* Close utility menus if open */
              var pm = document.getElementById("portalMenu");
              var am = document.getElementById("accountMenu");
              if (pm) pm.classList.remove("open");
              if (am) am.classList.remove("open");
              var pc = document.getElementById("portalChevron");
              if (pc) {
                pc.classList.remove("mdi-chevron-up");
                pc.classList.add("mdi-chevron-down");
              }
              /* Position and toggle the nav popover */
              positionNavPopover();
              navAlertPopover.classList.toggle("open");
            });

            /* Reposition on resize */
            window.addEventListener("resize", function () {
              if (navAlertPopover.classList.contains("open")) {
                positionNavPopover();
              }
            });

            /* Close bell popover when clicking outside */
            document.addEventListener("click", function (e) {
              if (
                navAlertPopover.classList.contains("open") &&
                !navAlertPopover.contains(e.target) &&
                !navBellBtn.contains(e.target)
              ) {
                navAlertPopover.classList.remove("open");
              }
            });

            /* ===== BELL ICON STATE & BADGE COUNT ===== */
            var navBellIcon = document.getElementById("navBellIcon");
            var navBellBadge = document.getElementById("navBellBadge");

            /* Update bell icon (outlined/filled) and badge count based on
               the number of UNREAD items in the nav notifications popover. */
            function updateBellState() {
              var notifList = navAlertPopover.querySelector(".notif-list");
              var unreadCount = notifList
                ? notifList.querySelectorAll(".notif-item.unread").length
                : 0;

              if (unreadCount === 0) {
                /* No unread — outlined bell, hide badge */
                if (navBellIcon) {
                  navBellIcon.classList.remove("mdi-bell");
                  navBellIcon.classList.add("mdi-bell-outline");
                }
                if (navBellBadge) navBellBadge.textContent = "";
              } else {
                /* Has unread — filled bell, show badge with count */
                if (navBellIcon) {
                  navBellIcon.classList.remove("mdi-bell-outline");
                  navBellIcon.classList.add("mdi-bell");
                }
                if (navBellBadge) {
                  navBellBadge.textContent =
                    unreadCount > 99 ? "99+" : String(unreadCount);
                }
              }
            }

            /* ===== INJECT MESSAGE BODIES FROM data-message ===== */
            navAlertPopover
              .querySelectorAll(".notif-item[data-message]")
              .forEach(function (item) {
                var msg = item.getAttribute("data-message");
                if (msg && !item.querySelector(".notif-item-message")) {
                  var msgDiv = document.createElement("div");
                  msgDiv.className = "notif-item-message";
                  msgDiv.textContent = msg;
                  item.appendChild(msgDiv);
                }
              });

            /* ===== HEADER DROP-SHADOW ON SCROLL ===== */
            var notifList = navAlertPopover.querySelector(".notif-list");
            var notifHeader = navAlertPopover.querySelector(".notif-header");
            if (notifList && notifHeader) {
              notifList.addEventListener("scroll", function () {
                if (this.scrollTop > 0) {
                  notifHeader.classList.add("scrolled");
                } else {
                  notifHeader.classList.remove("scrolled");
                }
              });
            }

            /* Initialize bell state & counts */
            updatePopoverCounts(navAlertPopover);
            updateBellState();

            /* ===== EXPAND / COLLAPSE CHEVRON — also marks as read ===== */
            navAlertPopover.addEventListener("click", function (e) {
              var expandBtn = e.target.closest(".notif-expand");
              if (expandBtn) {
                e.preventDefault();
                e.stopPropagation();
                var item = expandBtn.closest(".notif-item");
                if (!item) return;
                /* Toggle expanded state */
                item.classList.toggle("expanded");
                /* When expanding an unread item, mark it as read */
                if (
                  item.classList.contains("expanded") &&
                  item.classList.contains("unread")
                ) {
                  item.classList.remove("unread");
                  var dot = item.querySelector(".notif-unread-dot");
                  if (dot) dot.remove();
                  updatePopoverCounts(navAlertPopover);
                  updateBellState();
                }
                return;
              }

              /* ===== DISMISS (X) — REMOVE TILE FROM LIST ===== */
              var dismissBtn = e.target.closest(".notif-dismiss");
              if (!dismissBtn) return;
              e.preventDefault();
              e.stopPropagation();
              var item = dismissBtn.closest(".notif-item");
              if (!item) return;

              /* Animate removal */
              item.style.transition =
                "opacity 0.2s ease, max-height 0.3s ease, margin 0.3s ease, padding 0.3s ease";
              item.style.opacity = "0";
              item.style.maxHeight = item.offsetHeight + "px";
              item.style.overflow = "hidden";
              requestAnimationFrame(function () {
                item.style.maxHeight = "0";
                item.style.marginTop = "0";
                item.style.marginBottom = "0";
                item.style.paddingTop = "0";
                item.style.paddingBottom = "0";
              });
              setTimeout(function () {
                item.remove();
                updatePopoverCounts(navAlertPopover);
                updateBellState();
              }, 300);
            });
          }

          /* ===== TOP-ROW DETECTION HELPER ===== */
          function isTopRowCard(card) {
            var grid = card.parentElement;
            if (!grid) return false;
            /* Find the first *visible* card — hidden cards (display:none)
               have offsetTop 0 which breaks the comparison after filtering. */
            var cards = grid.querySelectorAll(".case-card");
            var firstCard = null;
            for (var i = 0; i < cards.length; i++) {
              if (cards[i].style.display !== "none") {
                firstCard = cards[i];
                break;
              }
            }
            if (!firstCard) return false;
            return card.offsetTop === firstCard.offsetTop;
          }

          /* ===== CARD-LEVEL DANGER INDICATOR TOGGLE ===== */
          var dangerIndicators = document.querySelectorAll(
            ".alert-indicator-danger"
          );

          dangerIndicators.forEach(function (indicator) {
            indicator.addEventListener("click", function (e) {
              e.stopPropagation();
              var card = this.closest(".case-card");
              if (!card) return;
              var popover = card.querySelector(
                ".alert-popover:not(.alert-popover-warning):not(.alert-popover-info)"
              );
              if (!popover) return;

              /* Close all other popovers first (including nav popover) */
              document
                .querySelectorAll(".alert-popover.open")
                .forEach(function (p) {
                  if (p !== popover) p.classList.remove("open");
                });
              /* Position popover relative to card, centered on indicator */
              var cardRect = card.getBoundingClientRect();
              var indicatorRect = indicator.getBoundingClientRect();
              var popoverWidth = cardRect.width;
              var viewportWidth = window.innerWidth;

              /* Set width to match parent card */
              popover.style.width = popoverWidth + "px";

              /* Vertical: center popover on the indicator (relative to card) */
              var indicatorMiddleRel =
                indicatorRect.top - cardRect.top + indicatorRect.height / 2;
              var popoverHeight = 350;
              var popoverTop = indicatorMiddleRel - popoverHeight / 2;
              if (isTopRowCard(card)) popoverTop += 24;
              popover.style.top = popoverTop + "px";

              /* Arrow: point at indicator center relative to popover */
              var arrowTop = indicatorMiddleRel - popoverTop;
              popover.style.setProperty("--arrow-top", arrowTop + "px");

              /* Horizontal: left edge 12px to the right of indicator */
              popover.classList.remove("arrow-left", "arrow-right");
              var leftOffset = indicatorRect.right - cardRect.left + 12;
              var popoverRight = cardRect.left + leftOffset + popoverWidth;

              if (popoverRight > viewportWidth) {
                /* Would go off-screen: right edge 12px to the left of indicator */
                leftOffset =
                  indicatorRect.left - cardRect.left - popoverWidth - 12;
                popover.classList.add("arrow-right");
              } else {
                popover.classList.add("arrow-left");
              }
              popover.style.left = leftOffset + "px";
              popover.classList.toggle("open");
            });
          });

          /* ===== CARD-LEVEL WARNING INDICATOR TOGGLE ===== */
          var warningIndicators = document.querySelectorAll(
            ".alert-indicator-warning"
          );

          warningIndicators.forEach(function (indicator) {
            indicator.addEventListener("click", function (e) {
              e.stopPropagation();
              var card = this.closest(".case-card");
              if (!card) return;
              var popover = card.querySelector(".alert-popover-warning");
              if (!popover) return;

              /* Close all other popovers first (including nav popover) */
              document
                .querySelectorAll(".alert-popover.open")
                .forEach(function (p) {
                  if (p !== popover) p.classList.remove("open");
                });
              /* Position popover relative to card, centered on indicator */
              var cardRect = card.getBoundingClientRect();
              var indicatorRect = indicator.getBoundingClientRect();
              var popoverWidth = cardRect.width;
              var viewportWidth = window.innerWidth;

              /* Set width to match parent card */
              popover.style.width = popoverWidth + "px";

              /* Vertical: center popover on the indicator (relative to card) */
              var indicatorMiddleRel =
                indicatorRect.top - cardRect.top + indicatorRect.height / 2;
              var popoverHeight = 350;
              var popoverTop = indicatorMiddleRel - popoverHeight / 2;
              if (isTopRowCard(card)) popoverTop += 24;
              popover.style.top = popoverTop + "px";

              /* Arrow: point at indicator center relative to popover */
              var arrowTop = indicatorMiddleRel - popoverTop;
              popover.style.setProperty("--arrow-top", arrowTop + "px");

              /* Horizontal: left edge 12px to the right of indicator */
              popover.classList.remove("arrow-left", "arrow-right");
              var leftOffset = indicatorRect.right - cardRect.left + 12;
              var popoverRight = cardRect.left + leftOffset + popoverWidth;

              if (popoverRight > viewportWidth) {
                /* Would go off-screen: right edge 12px to the left of indicator */
                leftOffset =
                  indicatorRect.left - cardRect.left - popoverWidth - 12;
                popover.classList.add("arrow-right");
              } else {
                popover.classList.add("arrow-left");
              }
              popover.style.left = leftOffset + "px";
              popover.classList.toggle("open");
            });
          });

          /* ===== CARD-LEVEL INFO INDICATOR TOGGLE ===== */
          var infoIndicators = document.querySelectorAll(
            ".alert-indicator-info"
          );

          infoIndicators.forEach(function (indicator) {
            indicator.addEventListener("click", function (e) {
              e.stopPropagation();
              var card = this.closest(".case-card");
              if (!card) return;
              var popover = card.querySelector(".alert-popover-info");
              if (!popover) return;

              /* Close all other popovers first (including nav popover) */
              document
                .querySelectorAll(".alert-popover.open")
                .forEach(function (p) {
                  if (p !== popover) p.classList.remove("open");
                });
              /* Position popover relative to card, centered on indicator */
              var cardRect = card.getBoundingClientRect();
              var indicatorRect = indicator.getBoundingClientRect();
              var popoverWidth = cardRect.width;
              var viewportWidth = window.innerWidth;

              /* Set width to match parent card */
              popover.style.width = popoverWidth + "px";

              /* Vertical: center popover on the indicator (relative to card) */
              var indicatorMiddleRel =
                indicatorRect.top - cardRect.top + indicatorRect.height / 2;
              var popoverHeight = 350;
              var popoverTop = indicatorMiddleRel - popoverHeight / 2;
              if (isTopRowCard(card)) popoverTop += 24;
              popover.style.top = popoverTop + "px";

              /* Arrow: point at indicator center relative to popover */
              var arrowTop = indicatorMiddleRel - popoverTop;
              popover.style.setProperty("--arrow-top", arrowTop + "px");

              /* Horizontal: left edge 12px to the right of indicator */
              popover.classList.remove("arrow-left", "arrow-right");
              var leftOffset = indicatorRect.right - cardRect.left + 12;
              var popoverRight = cardRect.left + leftOffset + popoverWidth;

              if (popoverRight > viewportWidth) {
                /* Would go off-screen: right edge 12px to the left of indicator */
                leftOffset =
                  indicatorRect.left - cardRect.left - popoverWidth - 12;
                popover.classList.add("arrow-right");
              } else {
                popover.classList.add("arrow-left");
              }
              popover.style.left = leftOffset + "px";
              popover.classList.toggle("open");
            });
          });

          /* Click-away: close any open alert popover */
          document.addEventListener("click", function (e) {
            document
              .querySelectorAll(".alert-popover.open")
              .forEach(function (popover) {
                if (!popover.contains(e.target)) {
                  /* Check if click was on the nav bell button */
                  var navWrapper = document.getElementById("navAlertWrapper");
                  if (navWrapper && navWrapper.contains(e.target)) return;
                  /* Check if click was on a card indicator (danger or warning) */
                  var card = popover.closest(".case-card");
                  var dangerInd = card
                    ? card.querySelector(".alert-indicator-danger")
                    : null;
                  var warningInd = card
                    ? card.querySelector(".alert-indicator-warning")
                    : null;
                  var infoInd = card
                    ? card.querySelector(".alert-indicator-info")
                    : null;
                  var clickedIndicator =
                    (dangerInd && dangerInd.contains(e.target)) ||
                    (warningInd && warningInd.contains(e.target)) ||
                    (infoInd && infoInd.contains(e.target));
                  if (!clickedIndicator) {
                    popover.classList.remove("open");
                  }
                }
              });
          });

          /* Close button in popover header */
          document
            .querySelectorAll(".alert-popover-close")
            .forEach(function (btn) {
              btn.addEventListener("click", function (e) {
                e.stopPropagation();
                var popover = this.closest(".alert-popover");
                if (popover) popover.classList.remove("open");
              });
            });

          /* Header shadow on scroll — show when list is scrolled, hide at top */
          document
            .querySelectorAll(".alert-popover-list")
            .forEach(function (list) {
              list.addEventListener("scroll", function () {
                var header = this.previousElementSibling;
                if (
                  header &&
                  header.classList.contains("alert-popover-header")
                ) {
                  if (this.scrollTop > 0) {
                    header.classList.add("scrolled");
                  } else {
                    header.classList.remove("scrolled");
                  }
                }
              });
            });

          /* Reposition open popovers on viewport resize */
          function repositionOpenPopovers() {
            document
              .querySelectorAll(".alert-popover.open")
              .forEach(function (popover) {
                /* Skip nav-level popover — it's positioned via CSS */
                if (popover.id === "navAlertPopover") return;
                var card = popover.closest(".case-card");
                if (!card) return;
                var isWarning = popover.classList.contains(
                  "alert-popover-warning"
                );
                var isInfo = popover.classList.contains("alert-popover-info");
                var indicatorClass = isInfo
                  ? ".alert-indicator-info"
                  : isWarning
                    ? ".alert-indicator-warning"
                    : ".alert-indicator-danger";
                var indicator = card.querySelector(indicatorClass);
                if (!indicator) return;

                var cardRect = card.getBoundingClientRect();
                var indicatorRect = indicator.getBoundingClientRect();
                var popoverWidth = cardRect.width;
                var viewportWidth = window.innerWidth;

                popover.style.width = popoverWidth + "px";

                var indicatorMiddleRel =
                  indicatorRect.top - cardRect.top + indicatorRect.height / 2;
                var popoverHeight = 350;
                var popoverTop = indicatorMiddleRel - popoverHeight / 2;
                if (isTopRowCard(card)) popoverTop += 24;
                popover.style.top = popoverTop + "px";

                var arrowTop = indicatorMiddleRel - popoverTop;
                popover.style.setProperty("--arrow-top", arrowTop + "px");

                popover.classList.remove("arrow-left", "arrow-right");
                var leftOffset = indicatorRect.right - cardRect.left + 12;
                var popoverRight = cardRect.left + leftOffset + popoverWidth;

                if (popoverRight > viewportWidth) {
                  leftOffset =
                    indicatorRect.left - cardRect.left - popoverWidth - 12;
                  popover.classList.add("arrow-right");
                } else {
                  popover.classList.add("arrow-left");
                }
                popover.style.left = leftOffset + "px";
              });
          }
          window.addEventListener("resize", repositionOpenPopovers);

          /* Prevent popover clicks from propagating to card */
          document
            .querySelectorAll(".alert-popover")
            .forEach(function (popover) {
              popover.addEventListener("click", function (e) {
                e.stopPropagation();
              });
            });
        })();

        /* ========== INITIAL RENDER ========== */
        applyFilterAndSort();
      })();
    </script>
  </body>
</html>
