      <!-- Card 1 -->
      <div
        class="case-card"
        data-tooltip="Jane Doe, John Roe, Alice Smith, and Robert Johnson, Plaintiffs, v. Acme Corporation, Defendant"
      >
        <div class="card-body">
          <div class="card-top">
            <div class="card-titles">
              <div class="card-title">
                Jane Doe, John Roe, Alice Smith, and Robert Johnson, Plaintiffs,
                v. Acme Corporation, Defendant
              </div>
            </div>
          </div>
          <div class="card-ref-line">
            <span class="ref-label">Reference ID:</span>
            <span class="ref-value">2345-6789-01234-567890-XYZ-0456</span>
          </div>
          <div class="card-created">
            Created by: Jon Snow on Fri Feb 20, 2025
          </div>
          <div class="card-chevron">
            <span class="mdi mdi-chevron-down"></span
            ><span class="mdi mdi-chevron-up"></span>
          </div>
        </div>
        <div class="card-expanded-wrapper">
          <div class="card-expanded-content">
            <p class="card-description">
              Plaintiffs allege that Acme Corporation knowingly distributed
              defective industrial equipment, resulting in workplace injuries at
              multiple facilities. The complaint seeks compensatory and punitive
              damages under strict product liability.
            </p>
            <div class="card-metadata">
              <div class="card-metadata-row">
                <span class="metadata-label">Primary Counsel</span>
                <span class="metadata-value">William Miller</span>
              </div>
              <div class="card-metadata-row">
                <span class="metadata-label">Outside Counsel</span>
                <span class="metadata-value">Daniel Garcia</span>
              </div>
              <div class="card-metadata-row">
                <span class="metadata-label">Natural Persons</span>
                <span class="metadata-value">1</span>
              </div>
              <div class="card-metadata-row">
                <span class="metadata-label">Identities</span>
                <span class="metadata-value">20</span>
              </div>
              <div class="card-metadata-row">
                <span class="metadata-label">Interviews</span>
                <span class="metadata-value-compound"
                  ><span class="metadata-value">6</span
                  ><span class="metadata-divider"></span
                  ><span class="metadata-value metadata-value-warning"
                    >3 Needs Attention</span
                  ></span
                >
              </div>
            </div>
          </div>
        </div>
        <div class="card-footer">
          <div class="card-footer-status">
            <span class="status-dot status-dot-active"></span>
            <span class="status-label">Active</span>
