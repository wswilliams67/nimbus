<!doctype html>
<html lang="en" data-cnds-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Case Card Demo — CNDS Nimbus v9</title>
    <style>
      /* ===== MDI FONT ===== */
      @font-face {
        font-family: "Material Design Icons";
        src:
          url("fonts/mdi/materialdesignicons-webfont.woff2?v=7.4.47")
            format("woff2"),
          url("fonts/mdi/materialdesignicons-webfont.woff?v=7.4.47")
            format("woff"),
          url("fonts/mdi/materialdesignicons-webfont.ttf?v=7.4.47")
            format("truetype");
        font-weight: normal;
        font-style: normal;
      }
      .mdi::before {
        display: inline-block;
        font-family: "Material Design Icons";
        font-style: normal;
        font-weight: normal;
        font-variant: normal;
        text-transform: none;
        line-height: 1;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      .mdi-hand-front-left::before {
        content: "\F182B";
      }
      .mdi-alert::before {
        content: "\F0026";
      }
      .mdi-information::before {
        content: "\F02FC";
      }
      .mdi-chevron-down::before {
        content: "\F0140";
      }
      .mdi-chevron-up::before {
        content: "\F0143";
      }
      .mdi-apps::before {
        content: "\F003B";
      }
      .mdi-bell::before {
        content: "\F009A";
      }
      .mdi-bell-outline::before {
        content: "\F009C";
      }
      .mdi-weather-night::before {
        content: "\F0594";
      }
      .mdi-weather-sunny::before {
        content: "\F0599";
      }
      .mdi-view-dashboard::before {
        content: "\F056E";
      }
      .mdi-folder-account::before {
        content: "\F024C";
      }
      .mdi-home-account::before {
        content: "\F0826";
      }
      .mdi-key-chain::before {
        content: "\F1574";
      }
      .mdi-close-circle::before {
        content: "\F0159";
      }
      .mdi-page-first::before {
        content: "\F0600";
      }
      .mdi-chevron-left::before {
        content: "\F0141";
      }
      .mdi-chevron-right::before {
        content: "\F0142";
      }
      .mdi-page-last::before {
        content: "\F0601";
      }
      .mdi-arrow-up-circle-outline::before {
        content: "\F0CE1";
      }
      .mdi-arrow-down-circle-outline::before {
        content: "\F0CDB";
      }
      .mdi-close::before {
        content: "\F0156";
      }

      /* ===== FONTS ===== */
      @font-face {
        font-family: "Nunito";
        src:
          url("fonts/nunito/Nunito-SemiBold.woff2") format("woff2"),
          url("fonts/nunito/Nunito-SemiBold.woff") format("woff");
        font-weight: 600;
        font-style: normal;
      }
      @font-face {
        font-family: "Nunito Sans";
        src:
          url("fonts/nunitosans/nunito-sans-latin-400-normal.woff2")
            format("woff2"),
          url("fonts/nunitosans/nunito-sans-latin-400-normal.woff")
            format("woff");
        font-weight: 400;
        font-style: normal;
      }
      @font-face {
        font-family: "Nunito Sans";
        src:
          url("fonts/nunitosans/nunito-sans-latin-500-normal.woff2")
            format("woff2"),
          url("fonts/nunitosans/nunito-sans-latin-500-normal.woff")
            format("woff");
        font-weight: 500;
        font-style: normal;
      }
      @font-face {
        font-family: "Nunito Sans";
        src:
          url("fonts/nunitosans/nunito-sans-latin-700-normal.woff2")
            format("woff2"),
          url("fonts/nunitosans/nunito-sans-latin-700-normal.woff")
            format("woff");
        font-weight: 700;
        font-style: normal;
      }
      @font-face {
        font-family: "Nunito Sans";
        src: url("fonts/nunitosans/nunito-sans-latin-800-normal.woff2")
          format("woff2");
        font-weight: 800;
        font-style: normal;
      }

      /* ===== LIGHT THEME (default) ===== */
      :root,
      [data-cnds-theme="light"] {
        --cnds-list-hover-bg: #e0e0e0;
        --cnds-list-active-bg: #2e892a;
        --cnds-list-active-color: #fff;
        color-scheme: light;
        --cnds-body-color: #141414;
        --cnds-body-bg: #fafafa;
        --cnds-surface-raised: #f5f5f5;
        --cnds-surface-sunken: #ebebeb;
        --cnds-surface-overlay: #e0e0e0;
        --cnds-border-color: #e0e0e0;
        --cnds-border-strong: #cccccc;
        --cnds-border-muted: #a3a3a3;
        --cnds-link-color: #215aab;
        --cnds-link-hover-bg: rgba(33, 90, 171, 0.08);
        --cnds-btn-primary-bg: #215aab;
        --cnds-btn-primary-color: #edf1f9;
        --cnds-btn-primary-hover: #1a4a8f;
        --cnds-nav-active-border: #2e892a;
        --cnds-nav-hover-bg: rgba(0, 0, 0, 0.05);
        --cnds-card-bg: #f5f5f5;
        --cnds-card-border: #e0e0e0;
        --cnds-input-bg: #fafafa;
        --cnds-input-border: #cccccc;
        --cnds-input-color: #141414;
        --cnds-input-placeholder: #787878;
        --cnds-tooltip-bg: #525252;
        --cnds-tooltip-color: #e8e8e8;
        --cnds-pagination-bg: #e0e0e0;
        --cnds-pagination-hover: #e8e8e8;
        --cnds-divider: #141414;
        --cnds-divider-muted: #a3a3a3;
        --cnds-color-danger: #942700;
        --cnds-color-warning: #8f6d00;
        --cnds-color-info: #0037c3;
        --cnds-color-success: #2d682f;
        --cnds-status-closed: #c23400;
        --cnds-status-active: #2e892a;
        --cnds-status-in-progress: #215aab;
        --cnds-status-pending: #8f6d00;
        --cnds-shadow-sticky: 0 4px 8px rgba(0, 0, 0, 0.1);
        --cnds-shadow-pagination: 0 4px 6px rgba(0, 0, 0, 0.15);
        --cnds-icon-fill: #141414;
        --cnds-title-stripe: #2e892a;
        --cnds-toolbar-bg: #d4d4d4;
        --cnds-toolbar-border: #cccccc;
        --cnds-avatar-bg: #cccccc;
        --cnds-select-arrow: url("data:image/svg+xml,%3Csvg width='18' height='18' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6 9L12 15L18 9' stroke='%23141414' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
        --cnds-select-arrow-sm: url("data:image/svg+xml,%3Csvg width='14' height='14' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6 9L12 15L18 9' stroke='%23141414' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
      }

      /* ===== DARK THEME ===== */
      [data-cnds-theme="dark"] {
        --cnds-list-hover-bg: #4a4a4a;
        --cnds-list-active-bg: #1d5a1d;
        --cnds-list-active-color: #7dd67a;
        color-scheme: dark;
        --cnds-body-color: #ebebeb;
        --cnds-body-bg: #252525;
        --cnds-surface-raised: #252525;
        --cnds-surface-sunken: #171717;
        --cnds-surface-overlay: #4a4a4a;
        --cnds-border-color: #4a4a4a;
        --cnds-border-strong: #787878;
        --cnds-border-muted: #787878;
        --cnds-link-color: #6790ca;
        --cnds-link-hover-bg: rgba(103, 144, 202, 0.12);
        --cnds-btn-primary-bg: #355d97;
        --cnds-btn-primary-color: #fff;
        --cnds-btn-primary-hover: #6790ca;
        --cnds-nav-active-border: #72b23e;
        --cnds-nav-hover-bg: rgba(255, 255, 255, 0.06);
        --cnds-card-bg: #1e1e1e;
        --cnds-card-border: #4a4a4a;
        --cnds-input-bg: #4a4a4a;
        --cnds-input-border: #787878;
        --cnds-input-color: #ebebeb;
        --cnds-input-placeholder: #e8e8e8;
        --cnds-tooltip-bg: #525252;
        --cnds-tooltip-color: #e8e8e8;
        --cnds-pagination-bg: #4a4a4a;
        --cnds-pagination-hover: #787878;
        --cnds-divider: #a3a3a3;
        --cnds-divider-muted: #787878;
        --cnds-color-danger: #ff5e24;
        --cnds-color-warning: #ffda62;
        --cnds-color-info: #4278ff;
        --cnds-color-success: #69be6b;
        --cnds-status-closed: #ff5e24;
        --cnds-status-active: #69be6b;
        --cnds-status-in-progress: #6790ca;
        --cnds-status-pending: #ffda62;
        --cnds-shadow-sticky: 0 4px 8px rgba(0, 0, 0, 0.4);
        --cnds-shadow-pagination: 0 4px 6px rgba(0, 0, 0, 0.4);
        --cnds-icon-fill: #ebebeb;
        --cnds-title-stripe: #72b23e;
        --cnds-toolbar-bg: #121212;
        --cnds-toolbar-border: #4a4a4a;
        --cnds-avatar-bg: #787878;
        --cnds-select-arrow: url("data:image/svg+xml,%3Csvg width='18' height='18' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6 9L12 15L18 9' stroke='%23ebebeb' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
        --cnds-select-arrow-sm: url("data:image/svg+xml,%3Csvg width='14' height='14' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6 9L12 15L18 9' stroke='%23ebebeb' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
      }

      /* ===== RESET & BASE ===== */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html,
      body {
        height: 100%;
        font-family: "Nunito Sans", sans-serif;
        font-weight: 400;
        font-size: 14px;
        line-height: 1.2;
        color: var(--cnds-body-color);
        background: var(--cnds-body-bg);
      }

      /* ===== STICKY HEADER ===== */
      .sticky-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 50;
        padding-bottom: 8px;
        background: var(--cnds-body-bg);
        transition: box-shadow 0.2s ease;
      }
      .sticky-header.scrolled {
        box-shadow: var(--cnds-shadow-sticky);
      }

      /* ===== UTILITY NAV ===== */
      .utility-nav {
        display: flex;
        align-items: center;
        height: 50px;
        padding: 8px 12px;
        background: var(--cnds-surface-sunken);
        gap: 48px;
      }
      .utility-nav-logo {
        display: flex;
        align-items: center;
        gap: 13px;
      }
      .product-name {
        display: flex;
        align-items: center;
        gap: 0;
        text-transform: uppercase;
        font-size: 22px;
        color: var(--cnds-body-color);
        white-space: nowrap;
      }
      .product-name-bold {
        font-family: "Nunito Sans", sans-serif;
        font-weight: 800;
        letter-spacing: 11.5px;
      }
      .product-name-light {
        font-family: "Nunito Sans", sans-serif;
        font-weight: 300;
        letter-spacing: 9px;
      }
      .utility-nav-tools {
        display: flex;
        flex: 1;
        align-items: center;
        justify-content: flex-end;
        gap: 16px;
      }
      .utility-divider {
        width: 1px;
        height: 24px;
        background: var(--cnds-divider);
      }
      .portal-switcher-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        height: 32px;
      }
      .portal-switcher {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 14px;
        color: var(--cnds-body-color);
        cursor: pointer;
      }
      .portal-switcher .mdi {
        color: var(--cnds-body-color);
      }
      .nav-icon-btn {
        position: relative;
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        display: flex;
        align-items: center;
        border-radius: 4px;
      }
      .nav-icon-btn .mdi {
        font-size: 24px;
        color: var(--cnds-icon-fill);
      }
      .user-info-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        height: 32px;
      }
      .user-info {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        color: var(--cnds-body-color);
        white-space: nowrap;
        cursor: pointer;
      }
      .user-avatar {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: inline-block;
        object-fit: cover;
        border: 1.5px solid #5ccb59;
        box-sizing: border-box;
      }

      /* --- Account Menu --- */
      .account-menu {
        display: none;
        position: absolute;
        top: calc(100% + 12px);
        right: 0;
        min-width: 180px;
        border: 1px solid var(--cnds-border-strong);
        border-radius: 8px;
        box-shadow:
          0 2px 15px -3px rgba(0, 0, 0, 0.07),
          0 10px 20px -2px rgba(0, 0, 0, 0.04),
          0 0 60px 10px rgba(0, 0, 0, 0.2);
        z-index: 1000;
        flex-direction: column;
      }
      .account-menu.open {
        display: flex;
      }
      /* Upward-pointing arrow on account menus */
      .account-menu::before {
        content: "";
        position: absolute;
        top: -9px;
        right: 12px;
        width: 0;
        height: 0;
        border-style: solid;
        border-width: 0 8px 9px 8px;
        border-color: transparent transparent var(--cnds-border-strong)
          transparent;
      }
      .account-menu::after {
        content: "";
        position: absolute;
        top: -7px;
        right: 13px;
        width: 0;
        height: 0;
        border-style: solid;
        border-width: 0 7px 8px 7px;
        border-color: transparent transparent var(--cnds-surface-sunken)
          transparent;
      }
      /* Adjust arrow position for portal menu (centered on portal icon) */
      #portalMenu::before {
        right: 8px;
      }
      #portalMenu::after {
        right: 9px;
      }
      .account-menu-header {
        background: var(--cnds-surface-sunken);
        padding: 12.5px 16px;
        font-family: "Nunito Sans", sans-serif;
        font-weight: 700;
        font-size: 14px;
        letter-spacing: 1.4px;
        text-transform: uppercase;
        color: var(--cnds-body-color);
        line-height: 1.4;
        border-radius: 8px 8px 0 0;
      }
      .account-menu-item {
        background: var(--cnds-surface-sunken);
        padding: 6px 16px;
        height: 44px;
        display: flex;
        align-items: center;
        font-family: "Nunito Sans", sans-serif;
        font-weight: 400;
        font-size: 14px;
        color: var(--cnds-body-color);
        line-height: 1.2;
        cursor: pointer;
        text-decoration: none;
        transition: background 0.15s ease;
      }
      .account-menu-item:last-child {
        border-radius: 0 0 8px 8px;
      }
      .account-menu-item:hover {
        background: var(--cnds-list-hover-bg);
      }
      .account-menu-item.active {
        background: var(--cnds-list-active-bg);
        color: #7dd67a;
      }

      /* ===== MAIN NAV ===== */
      .main-nav-wrapper {
        background: var(--cnds-body-bg);
        padding: 8px;
      }
      .main-nav {
        display: flex;
        align-items: center;
        height: 56px;
        background: var(--cnds-surface-sunken);
        border-radius: 8px;
        padding: 0 8px;
        overflow: hidden;
      }
      .main-nav-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 16px 24px;
        height: 56px;
        font-family: "Nunito", sans-serif;
        font-weight: 400;
        font-size: 14px;
        color: var(--cnds-body-color);
        text-decoration: none;
        white-space: nowrap;
        cursor: pointer;
        text-transform: capitalize;
        border-bottom: 3px solid transparent;
      }
      .main-nav-item:hover {
        background: var(--cnds-nav-hover-bg);
      }
      .main-nav-item.active {
        border-bottom-color: var(--cnds-nav-active-border);
      }
      .main-nav-item svg {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
      }
      .main-nav-item .mdi {
        font-size: 18px;
        line-height: 1;
        flex-shrink: 0;
      }

      /* ===== PAGE TITLE ===== */
      .page-title-bar {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        padding: 8px 16px;
        background: var(--cnds-body-bg);
      }
      .page-title {
        font-family: "Nunito Sans", sans-serif;
        font-weight: 700;
        font-size: 14px;
        line-height: 1.429;
        text-transform: uppercase;
        letter-spacing: 8px;
        color: var(--cnds-body-color);
        white-space: nowrap;
        padding-bottom: 16px;
      }
      .page-title-stripe {
        flex: 1;
        padding-top: 10px;
      }
      .page-title-stripe-line {
        height: 1px;
        background: var(--cnds-title-stripe);
      }

      /* ===== TOOLBAR ===== */
      .toolbar-wrapper {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0 16px;
        margin-bottom: 10px;
      }
      .toolbar {
        display: flex;
        flex: 1;
        align-items: center;
        gap: 8px;
        background: var(--cnds-toolbar-bg);
        border: 1px solid var(--cnds-toolbar-border);
        border-radius: 8px;
        padding: 8px 12px 8px 8px;
        overflow: hidden;
      }
      .search-input-wrapper {
        flex: 1;
        position: relative;
        display: flex;
        align-items: center;
      }
      .toolbar-search {
        width: 100%;
        height: 40px;
        padding: 0 32px 0 12px;
        border: 1px solid var(--cnds-input-border);
        border-radius: 8px;
        background: var(--cnds-input-bg);
        font-family: "Nunito Sans", sans-serif;
        font-size: 13px;
        color: var(--cnds-input-color);
        outline: none;
      }
      .search-clear {
        position: absolute;
        right: 8px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 18px;
        color: var(--cnds-input-placeholder);
        cursor: pointer;
        line-height: 1;
        opacity: 0;
        pointer-events: none;
      }
      .search-clear:hover {
        color: var(--cnds-body-color);
      }
      .search-input-wrapper.has-value .search-clear {
        opacity: 1;
        pointer-events: auto;
      }
      .toolbar-search::placeholder {
        color: var(--cnds-input-placeholder);
      }
      .btn-search {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px 12px;
        border: 2px solid var(--cnds-link-color);
        border-radius: 8px;
        background: transparent;
        font-family: "Nunito Sans", sans-serif;
        font-weight: 800;
        font-size: 12px;
        text-transform: uppercase;
        color: var(--cnds-link-color);
        cursor: pointer;
        white-space: nowrap;
      }
      .btn-search:hover {
        background: var(--cnds-link-hover-bg);
      }
      .toolbar-divider {
        width: 1px;
        height: 25px;
        background: var(--cnds-divider-muted);
        flex-shrink: 0;
      }
      .toolbar-label-group {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
      }
      .toolbar-label {
        font-family: "Nunito Sans", sans-serif;
        font-weight: 500;
        font-size: 14px;
        color: var(--cnds-body-color);
        text-transform: capitalize;
        white-space: nowrap;
      }
      .toolbar-select {
        width: 150px;
        height: 38px;
        padding: 0 36px 0 12px;
        border: 1px solid var(--cnds-input-border);
        border-radius: 8px;
        background-color: var(--cnds-input-bg);
        font-family: "Nunito Sans", sans-serif;
        font-size: 13px;
        color: var(--cnds-input-color);
        appearance: none;
        -webkit-appearance: none;
        background-image: var(--cnds-select-arrow);
        background-repeat: no-repeat;
        background-position: right 11px center;
        background-size: 18px;
        cursor: pointer;
      }
      .btn-asc-desc {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 82px;
        padding: 8px 12px;
        border: none;
        border-radius: 8px;
        background: transparent;
        font-family: "Nunito Sans", sans-serif;
        font-weight: 800;
        font-size: 12px;
        text-transform: uppercase;
        color: var(--cnds-link-color);
        cursor: pointer;
        white-space: nowrap;
      }
      .btn-asc-desc:hover {
        background: var(--cnds-link-hover-bg);
      }
      .btn-asc-desc .mdi {
        font-size: 18px;
      }
      .toolbar-total {
        font-family: "Nunito Sans", sans-serif;
        font-weight: 400;
        font-size: 14px;
        line-height: 1.43;
        color: var(--cnds-body-color);
        white-space: nowrap;
      }
      .btn-new-case {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px 20px;
        border: none;
        border-radius: 8px;
        background: var(--cnds-btn-primary-bg);
        font-family: "Nunito Sans", sans-serif;
        font-weight: 800;
        font-size: 16px;
        text-transform: uppercase;
        color: var(--cnds-btn-primary-color);
        cursor: pointer;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .btn-new-case:hover {
        background: var(--cnds-btn-primary-hover);
      }

      /* ===== CARD GRID ===== */
      .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(382px, 450px));
        gap: 16px;
        padding: 4px 16px 16px 16px;
        align-items: start;
      }

      /* ===== CASE CARD ===== */
      .case-card {
        position: relative;
        background: var(--cnds-card-bg);
        border: 1px solid var(--cnds-card-border);
        border-radius: 8px;
        overflow: visible;
        display: flex;
        flex-direction: column;
        transition: min-height 350ms ease;
      }
      .card-body {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 24px 24px 0 24px;
      }
      .card-top {
        display: flex;
        align-items: center;
        width: 100%;
      }
      .card-titles {
        flex: 1;
        min-width: 0;
      }
      .card-title {
        font-family: "Nunito", sans-serif;
        font-weight: 600;
        font-size: 20px;
        line-height: 1.2;
        color: var(--cnds-body-color);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-height: 24px; /* single line: 20px × 1.2 */
        transition: max-height 350ms ease; /* animate collapse */
      }
      .card-ref-line {
        display: flex;
        gap: 4px;
        font-family: "Nunito Sans", sans-serif;
        font-weight: 400;
        font-size: 14px;
        line-height: 1.2;
        color: var(--cnds-body-color);
        white-space: nowrap;
      }
      .ref-label {
        flex-shrink: 0;
      }
      .ref-value {
        flex-shrink: 0;
      }
      .card-created {
        font-family: "Nunito Sans", sans-serif;
        font-weight: 400;
        font-size: 12px;
        line-height: 1.43;
        color: var(--cnds-body-color);
      }
      .card-chevron {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        cursor: pointer;
      }
      .card-chevron .mdi {
        font-size: 24px;
        color: var(--cnds-link-color);
        transition: transform 0.3s ease;
      }
      .case-card.expanded .card-chevron .mdi-chevron-down {
        display: none;
      }
      .case-card:not(.expanded) .card-chevron .mdi-chevron-up {
        display: none;
      }

      /* ===== EXPANDED CONTENT ===== */
      .card-expanded-wrapper {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 350ms ease;
        flex-shrink: 0;
      }
      .card-expanded-wrapper > .card-expanded-content {
        overflow: hidden;
        min-height: 0;
        padding: 0 24px;
      }
      .case-card.expanded .card-expanded-wrapper {
        grid-template-rows: 1fr;
      }
      .case-card.expanded .card-expanded-content {
        padding: 0 24px 8px 24px;
      }
      .case-card.expanded .card-title {
        white-space: normal;
        overflow: hidden;
        text-overflow: unset;
        text-transform: capitalize;
        max-height: 200px; /* generous max for multi-line titles */
        transition: none; /* expand instantly so height measurement is accurate */
      }
      .card-description {
        font-family: "Nunito Sans", sans-serif;
        font-weight: 400;
        font-size: 16px;
        line-height: 1.2;
        color: var(--cnds-body-color);
        margin: 0 0 8px 0;
      }
      .card-metadata {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 8px 0;
      }
      .card-metadata-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2px 0;
      }
      .metadata-label {
        font-family: "Nunito Sans", sans-serif;
        font-weight: 700;
        font-size: 14px;
        line-height: 1.2;
        color: var(--cnds-body-color);
      }
      .metadata-value {
        font-family: "Nunito Sans", sans-serif;
        font-weight: 400;
        font-size: 14px;
        line-height: 1.2;
        color: var(--cnds-body-color);
      }
      .metadata-value-warning {
        color: var(--cnds-color-warning);
      }
      .metadata-value-compound {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .metadata-divider {
        width: 2px;
        align-self: stretch;
        background: var(--cnds-divider);
      }

      /* ===== CARD FOOTER ===== */
      .card-footer {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 4px 24px 24px 24px;
        margin-top: auto;
      }
      .card-footer-status {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
      }
      .status-dot {
        width: 16px;
        height: 16px;
        border-radius: 999px;
        flex-shrink: 0;
      }
      .status-dot-active {
        background: var(--cnds-status-active);
      }
      .status-dot-in-progress {
        background: var(--cnds-status-in-progress);
      }
      .status-dot-pending {
        background: var(--cnds-status-pending);
      }
      .status-dot-closed {
        background: var(--cnds-status-closed);
      }
      .status-label {
        font-family: "Nunito Sans", sans-serif;
        font-weight: 400;
        font-size: 14px;
        line-height: 1.2;
        color: var(--cnds-body-color);
        white-space: nowrap;
      }
      .card-footer-divider {
        width: 2px;
        height: 32px;
        background: var(--cnds-divider-muted);
        flex-shrink: 0;
      }
      .alert-indicator {
        display: flex;
        align-items: center;
        gap: 4px;
        flex-shrink: 0;
      }
      .alert-icon {
        font-size: 16px;
        line-height: 1;
        flex-shrink: 0;
      }
      .alert-count {
        font-family: "Nunito Sans", sans-serif;
        font-weight: 700;
        font-size: 12px;
        line-height: 1;
        letter-spacing: 0.24px;
        text-transform: capitalize;
      }
      .alert-count-danger {
        color: var(--cnds-color-danger);
      }
      .alert-count-warning {
        color: var(--cnds-color-warning);
      }
      .alert-count-info {
        color: var(--cnds-color-info);
      }
      .card-footer-spacer {
        flex: 1;
      }
      .btn-view {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 12px 16px;
        border: none;
        border-radius: 8px;
        background: transparent;
        font-family: "Nunito Sans", sans-serif;
        font-weight: 800;
        font-size: 14px;
        text-transform: uppercase;
        color: var(--cnds-link-color);
        cursor: pointer;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .btn-view:hover {
        background: var(--cnds-link-hover-bg);
      }

      /* ===== ALERT NOTIFICATION POPOVER ===== */
      .alert-indicator-danger,
      .alert-indicator-warning,
      .alert-indicator-info {
        cursor: pointer;
        position: relative;
      }
      .alert-indicator-danger:hover,
      .alert-indicator-warning:hover,
      .alert-indicator-info:hover {
        opacity: 0.8;
      }
      .alert-popover {
        display: none;
        position: absolute;
        top: 0;
        left: 0;
        height: 350px;
        border-radius: 8px;
        border: 1px solid var(--cnds-border-strong);
        box-shadow:
          0 2px 15px -3px rgba(0, 0, 0, 0.07),
          0 10px 20px -2px rgba(0, 0, 0, 0.04),
          0 0 60px 10px rgba(0, 0, 0, 0.2);
        z-index: 40;
        flex-direction: column;
        background: var(--cnds-body-bg);
      }
      .alert-popover.open {
        display: flex;
      }
      /* Triangle pointer arrow — vertical position via --arrow-top */
      .alert-popover::before {
        content: "";
        position: absolute;
        top: var(--arrow-top, 50%);
        transform: translateY(-50%);
        width: 0;
        height: 0;
        border-style: solid;
      }
      .alert-popover.arrow-left::before {
        left: -9px;
        border-width: 8px 9px 8px 0;
        border-color: transparent var(--cnds-border-strong) transparent
          transparent;
      }
      .alert-popover.arrow-left::after {
        content: "";
        position: absolute;
        top: var(--arrow-top, 50%);
        transform: translateY(-50%);
        left: -7px;
        width: 0;
        height: 0;
        border-style: solid;
        border-width: 7px 8px 7px 0;
        border-color: transparent var(--cnds-body-bg) transparent transparent;
      }
      .alert-popover.arrow-right::before {
        right: -9px;
        border-width: 8px 0 8px 9px;
        border-color: transparent transparent transparent
          var(--cnds-border-strong);
      }
      .alert-popover.arrow-right::after {
        content: "";
        position: absolute;
        top: var(--arrow-top, 50%);
        transform: translateY(-50%);
        right: -7px;
        width: 0;
        height: 0;
        border-style: solid;
        border-width: 7px 0 7px 8px;
        border-color: transparent transparent transparent var(--cnds-body-bg);
      }
      .alert-popover-header {
        display: flex;
        align-items: center;
        height: 44px;
        padding: 12.5px 16px;
        background: var(--cnds-surface-sunken);
        flex-shrink: 0;
        border-radius: 8px 8px 0 0;
        position: relative;
        z-index: 1;
      }
      .alert-popover-header.scrolled::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -8px;
        height: 8px;
        background: linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0.15),
          transparent
        );
        pointer-events: none;
      }
      .alert-popover-title {
        flex: 1;
        font-family: "Nunito Sans", sans-serif;
        font-weight: 700;
        font-size: 14px;
        letter-spacing: 1.4px;
        text-transform: uppercase;
        color: var(--cnds-body-color);
        line-height: 1.4;
      }
      .alert-popover-counts {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
      }
      .alert-popover-count {
        font-family: "Nunito Sans", sans-serif;
        font-weight: 400;
        font-size: 12px;
        line-height: 1.43;
        color: var(--cnds-body-color);
        white-space: nowrap;
      }
      .alert-popover-header-divider {
        width: 1px;
        height: 16px;
        background: var(--cnds-divider-muted);
        flex-shrink: 0;
        margin-left: 12px;
        margin-right: 4px;
      }
      .alert-popover-close {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 24px;
        height: 24px;
        flex-shrink: 0;
        cursor: pointer;
        color: var(--cnds-body-color);
        font-size: 24px;
        background: none;
        border: none;
        padding: 0;
        margin-left: 4px;
        opacity: 0.7;
      }
      .alert-popover-close:hover {
        opacity: 1;
      }
      .alert-popover-count {
        font-family: "Nunito Sans", sans-serif;
        font-weight: 400;
        font-size: 12px;
        line-height: 1.43;
        color: var(--cnds-body-color);
        white-space: nowrap;
      }
      .alert-popover-list {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
        border-radius: 0 0 8px 8px;
        scrollbar-gutter: stable;
      }
      /* Custom scrollbar — hidden by default, visible on hover/scroll */
      .alert-popover-list::-webkit-scrollbar {
        width: 8px;
      }
      .alert-popover-list::-webkit-scrollbar-track {
        background: transparent;
        border-radius: 4px;
      }
      .alert-popover-list::-webkit-scrollbar-thumb {
        background: transparent;
        border-radius: 4px;
        transition: background 0.2s ease;
      }
      .alert-popover-list:hover::-webkit-scrollbar-track {
        background: var(--cnds-input-bg);
        border: 1px solid var(--cnds-input-border);
      }
      .alert-popover-list:hover::-webkit-scrollbar-thumb {
        background: var(--cnds-border-muted);
      }
      .alert-popover-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 8px 16px;
        background: var(--cnds-color-danger-subtle, #ebbfc7);
        border: 2px solid var(--cnds-color-danger-border, #942700);
        border-radius: 8px;
        margin: 4px 8px;
      }
      .alert-popover-item-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 24px;
        height: 24px;
        color: var(--cnds-color-danger-text, #942700);
        font-size: 24px;
      }
      .alert-popover-item-text {
        flex: 1;
        min-width: 0;
        font-family: "Nunito Sans", sans-serif;
        font-weight: 400;
        font-size: 14px;
        line-height: 1.4;
        color: var(--cnds-color-danger-text, #942700);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .alert-popover-item-action {
        flex-shrink: 0;
        font-family: "Nunito Sans", sans-serif;
        font-weight: 700;
        font-size: 14px;
        line-height: 1.4;
        color: var(--cnds-color-danger-text, #942700);
        text-decoration: underline;
        text-transform: uppercase;
        cursor: pointer;
        background: none;
        border: none;
        padding: 0;
      }
      .alert-popover-item-action:hover {
        text-decoration: underline;
      }

      /* Warning variant for alert popover items */
      .alert-popover-item-warning {
        background: var(--cnds-color-warning-subtle, #fff3cc);
        border-color: var(--cnds-color-warning, #f3bc00);
      }
      .alert-popover-item-warning .alert-popover-item-icon {
        color: var(--cnds-color-warning-dark, #a65300);
      }
      .alert-popover-item-warning .alert-popover-item-text {
        color: var(--cnds-color-warning-dark, #a65300);
      }
      .alert-popover-item-warning .alert-popover-item-action {
        color: var(--cnds-color-warning-dark, #a65300);
      }

      /* Info variant for alert popover items */
      .alert-popover-item-info {
        background: var(--cnds-color-info-subtle, #d6e2ff);
        border-color: var(--cnds-color-info, #0037c3);
      }
      .alert-popover-item-info .alert-popover-item-icon {
        color: var(--cnds-color-info, #0037c3);
      }
      .alert-popover-item-info .alert-popover-item-text {
        color: var(--cnds-color-info, #0037c3);
      }
      .alert-popover-item-info .alert-popover-item-action {
        color: var(--cnds-color-info, #0037c3);
      }

      /* ===== NAV ALERT POPOVER (bell icon) ===== */
      .nav-alert-popover-wrapper {
        position: relative;
        display: flex;
        align-items: center;
      }
      /* ===== NOTIFICATION POPOVER — Figma 5944:66933 ===== */
      #navAlertPopover {
        position: fixed;
        right: 16px;
        left: auto;
        width: 400px;
        bottom: 16px;
        z-index: 1060;
        display: none;
        flex-direction: column;
        border: 1px solid var(--cnds-border-strong);
        border-radius: 8px;
        overflow: visible;
        background: var(--cnds-body-bg);
        box-shadow:
          0 2px 15px -3px rgba(0, 0, 0, 0.07),
          0 10px 20px -2px rgba(0, 0, 0, 0.04),
          0 0 60px 10px rgba(0, 0, 0, 0.2);
        font-family: "Nunito Sans", sans-serif;
        color: var(--cnds-body-color);
      }
      #navAlertPopover.open {
        display: flex;
      }
      /* Arrow pointing up toward the bell icon */
      #navAlertPopover::before {
        content: "";
        position: absolute;
        top: -9px;
        right: var(--nav-arrow-right, 12px);
        left: auto;
        transform: none;
        width: 0;
        height: 0;
        border-style: solid;
        border-width: 0 8px 9px 8px;
        border-color: transparent transparent var(--cnds-border-strong)
          transparent;
        z-index: 1;
      }
      #navAlertPopover::after {
        content: "";
        position: absolute;
        top: -7px;
        right: var(--nav-arrow-right, 13px);
        left: auto;
        transform: none;
        width: 0;
        height: 0;
        border-style: solid;
        border-width: 0 7px 8px 7px;
        border-color: transparent transparent var(--cnds-surface-sunken)
          transparent;
        z-index: 2;
      }
      /* Remove card-specific arrow classes when used in nav */
      #navAlertPopover.arrow-left::before,
      #navAlertPopover.arrow-left::after,
      #navAlertPopover.arrow-right::before,
      #navAlertPopover.arrow-right::after {
        display: none;
      }

      /* --- Notif header --- */
      .notif-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding: 12px 16px;
        background: var(--cnds-surface-sunken);
        border-radius: 8px 8px 0 0;
        flex-shrink: 0;
        position: relative;
        z-index: 1;
      }
      .notif-header.scrolled::after {
        content: "";
        position: absolute;
        left: 0;
        right: 0;
        bottom: -12px;
        height: 12px;
        background: linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0.45),
          transparent
        );
        pointer-events: none;
      }
      .notif-header-title {
        font-weight: 700;
        font-size: 14px;
        letter-spacing: 1.4px;
        text-transform: uppercase;
        line-height: 1.4;
        color: var(--cnds-body-color);
      }
      .notif-header-counts {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 400;
        font-size: 12px;
        line-height: 1.43;
        color: var(--cnds-body-color);
      }
      .notif-header-divider {
        display: inline-block;
        width: 1px;
        height: 16px;
        background: var(--cnds-divider-muted);
      }

      /* --- Notif list (scrollable) --- */
      .notif-list {
        flex: 1 1 auto;
        overflow-y: auto;
        overflow-x: hidden;
        min-height: 0;
        border-radius: 0 0 8px 8px;
      }
      /* Auto-hide scrollbar: transparent until hovering */
      .notif-list::-webkit-scrollbar {
        width: 8px;
      }
      .notif-list::-webkit-scrollbar-track {
        background: transparent;
      }
      .notif-list::-webkit-scrollbar-thumb {
        background: transparent;
        border-radius: 4px;
        transition: background 0.2s ease;
      }
      .notif-list:hover::-webkit-scrollbar-thumb {
        background: var(--cnds-border-muted);
      }
      .notif-list:hover::-webkit-scrollbar-track {
        background: var(--cnds-input-bg);
      }

      /* --- Notif item --- */
      .notif-item {
        position: relative;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        padding: 16px 8px 16px 16px;
        border-top: 1px solid var(--cnds-divider-muted);
        background: var(--cnds-body-bg);
        transition:
          opacity 0.2s ease,
          max-height 0.3s ease;
      }

      /* Unread dot — red circle at left edge */
      .notif-unread-dot {
        display: none;
      }
      .notif-item.unread .notif-unread-dot {
        display: block;
        position: absolute;
        left: 5px;
        top: 4px;
        width: 8px;
        height: 8px;
        border-radius: 999px;
        background: var(--cnds-badge-bg-default, #c23400);
        pointer-events: none;
      }

      /* Unread items: bold subject & timestamp */
      .notif-item.unread .notif-subject {
        font-weight: 700;
      }
      .notif-item.unread .notif-timestamp {
        font-weight: 700;
      }

      /* Label takes remaining space in the row */
      .notif-item-label {
        flex: 1 1 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
      }
      .notif-subject {
        font-weight: 400;
        font-size: 14px;
        line-height: 1.2;
        color: var(--cnds-body-color);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .notif-timestamp {
        font-weight: 400;
        font-size: 10px;
        line-height: 1.43;
        color: var(--cnds-text-muted);
      }

      /* Expand / dismiss buttons */
      .notif-expand,
      .notif-dismiss {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        background: transparent;
        cursor: pointer;
        padding: 0;
        color: var(--cnds-text-muted);
      }
      .notif-expand {
        width: 24px;
        height: 24px;
        font-size: 24px;
      }
      .notif-dismiss {
        width: 20px;
        height: 20px;
        font-size: 18px;
      }
      .notif-expand:hover,
      .notif-dismiss:hover {
        color: var(--cnds-body-color);
      }

      /* Expanded message body — full width below the row */
      .notif-item-message {
        display: none;
        flex-basis: 100%;
        font-weight: 400;
        font-size: 12px;
        line-height: 1.1;
        color: var(--cnds-body-color);
        padding-right: 52px;
      }
      .notif-item.expanded .notif-item-message {
        display: block;
      }
      .notif-item.expanded .notif-expand::before {
        content: "\F0143"; /* mdi-chevron-up */
      }
      /* Notification count badge on bell icon — Figma node 5958:4596 */
      .nav-bell-badge {
        position: absolute;
        top: calc(50% - 1px);
        left: 50%;
        transform: translate(-50%, -50%);
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 14px;
        height: 12px;
        padding: 0 5px;
        border-radius: 2px;
        background: var(--cnds-color-danger, #c23400);
        color: var(--cnds-badge-text-default, #e8e8e8);
        font-family: "Nunito Sans", sans-serif;
        font-weight: 700;
        font-size: 10px;
        line-height: 1;
        letter-spacing: 0.2px;
        text-align: center;
        white-space: nowrap;
        pointer-events: none;
      }
      .nav-bell-badge:empty,
      .nav-bell-badge.hidden {
        display: none;
      }

      /* ===== TOOLTIP ===== */
      .case-tooltip {
        position: fixed;
        z-index: 200;
        background: var(--cnds-tooltip-bg);
        opacity: 0.9;
        color: var(--cnds-tooltip-color);
        font-family: "Nunito Sans", sans-serif;
        font-weight: 400;
        font-size: 13px;
        line-height: 1.2;
        padding: 12px 16px;
        border-radius: 4px;
        white-space: nowrap;
        pointer-events: none;
        display: none;
      }

      /* ===== PAGINATION ===== */
      .pagination-bar {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 16px;
        padding: 12px 16px;
        background: var(--cnds-toolbar-bg);
        border-radius: 8px;
        font-family: "Nunito Sans", sans-serif;
        font-size: 13px;
        color: var(--cnds-body-color);
        position: fixed;
        bottom: 16px;
        left: 16px;
        right: 16px;
        z-index: 100;
        box-shadow: var(--cnds-shadow-pagination);
      }
      .pagination-bar label {
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
        color: var(--cnds-body-color);
      }
      .pagination-bar select {
        height: 30px;
        padding: 0 28px 0 8px;
        border: 1px solid var(--cnds-input-border);
        border-radius: 6px;
        background-color: var(--cnds-input-bg);
        font-family: "Nunito Sans", sans-serif;
        font-size: 13px;
        color: var(--cnds-input-color);
        appearance: none;
        -webkit-appearance: none;
        background-image: var(--cnds-select-arrow-sm);
        background-repeat: no-repeat;
        background-position: right 6px center;
        background-size: 14px;
        cursor: pointer;
      }
      .pagination-info {
        white-space: nowrap;
      }
      .pagination-controls {
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .pagination-controls button {
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        border-radius: 6px;
        background: transparent;
        cursor: pointer;
        color: var(--cnds-link-color);
        font-size: 24px;
      }
      .pagination-controls button:disabled {
        opacity: 0.4;
        cursor: default;
        pointer-events: none;
      }

      /* ===== SVG THEME FILL ===== */
      .themed-fill {
        fill: var(--cnds-icon-fill);
      }
      .themed-stroke {
        stroke: var(--cnds-icon-fill);
      }
    </style>
  </head>
